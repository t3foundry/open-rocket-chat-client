# Origin of the Open Rocket.Chat gateway.
#
# In development this is only the proxy target — the browser still talks to the
# Vite dev server, which keeps the session cookie same-origin.
#
# In production, set it to the gateway's public origin. If that is a different
# site from this app, the gateway must also run with
# SESSION_COOKIE_SAMESITE=none over HTTPS and list this origin in CORS_ORIGINS.
VITE_GATEWAY_URL=http://localhost:4000

# Identifies the build to the persisted query cache.
#
# The cache in IndexedDB is keyed by this value, so a deployment that changes
# it forces every returning browser to start from a cold cache instead of
# restoring rooms and messages an older build wrote in a shape the new one no
# longer expects. Unset means `dev`, which is what you want locally.
#
# In CI, set it to something that changes per build — the commit SHA is the
# obvious choice: VITE_BUILD_ID=$GITHUB_SHA
VITE_BUILD_ID=

# API key for GIF search in the message box, from
# https://developers.giphy.com/dashboard/.
#
# Optional: leave it unset and each person can paste their own key under
# Settings → GIFs, which is stored in their browser and overrides this one.
# The key identifies the deployment to GIPHY rather than any user, so shipping
# it in the client bundle is what GIPHY's browser keys are for.
VITE_GIPHY_API_KEY=

# ── Tasra end-to-end encrypted channels (SDK 0.5.0, metered sessions) ─────────
#
# A reader pays nothing and holds nothing the channel slot's owner holds: no
# creator key, no gas, no rule and no rule salt. The client signs with a random
# key of its own per login session, presents the reader credential the gateway
# issues, and keeps one decrypt session per channel slot. The keepers meter the
# work against the slot's balance, which the slot's owner funds.
#
# None of these is a secret: a `VITE_` variable is inlined into the client bundle.

# The Tasra network this build talks to, as JSON on one line. Unset, the build
# uses the checked-in manifest (src/features/tasra/network.json).
#
# Either a release network manifest, or an application deployment document:
#   {"schemaVersion":1,"name":"…","chainId":…,"rpcUrl":"…","coordinator":"assigned-first",
#    "addresses":{"KeyRegistry":"0x…","NodeRegistry":"0x…","ServiceRegistry":"0x…",
#                 "VerifierSetRegistry":"0x…","ThresholdRandomBeacon":"0x…", …},
#    "verifierAgentUrl":"https://…",
#    "keeperUrls":{"https://registered-keeper-url":"http://127.0.0.1:8091", …}}
# A session needs KeyRegistry, NodeRegistry, ServiceRegistry, VerifierSetRegistry
# and ThresholdRandomBeacon. `keeperUrls` maps each REGISTERED keeper URL to one
# this browser can reach: that is all a local fleet needs (plain HTTP to loopback
# keepers is allowed on the local chain 43112 only).
VITE_TASRA_NETWORK_MANIFEST=

# The approved service-profile document for the network's verifier agent, as JSON
# on one line (schemaVersion, chainId, registry, verifierAgents[…]). Required to
# decrypt. This is the application's own reviewed pin of the agent's registry
# identity; the SDK does not take it from the chain.
VITE_TASRA_AGENT_PROFILE=

# Optional. The network's default verifier committee, as <committee>/<quorum>
# (e.g. 3/2), for channel slots that name no policy of their own on chain.
VITE_TASRA_VERIFIER_POLICY=

# Optional, comma-separated. Origins that serve the verifier-set snapshot
# artifacts. Unset, the registered accountants are used (read from the chain).
# Set it for a local fleet whose accountants are registered under names this
# browser cannot resolve. Every artifact is verified against the chain either way.
VITE_TASRA_SNAPSHOT_HOSTS=
