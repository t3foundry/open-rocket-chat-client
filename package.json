{
  "name": "open-rocket-chat-client",
  "version": "0.1.2",
  "private": true,
  "description": "An independent, community-driven frontend for Rocket.Chat-compatible servers",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/t3foundry/open-rocket-chat-client.git"
  },
  "engines": {
    "node": ">=20.11"
  },
  "packageManager": "pnpm@12.16.1+sha512.091d1dee7927575661b25dab3c2ae31cafc1c54d6b71ed6a6600cf0c1cb10434a447eae14015f1b23e2e6bedeed79df94a932e2164d2832280dce3fb32f656d1",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "eslint .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,md,css,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,json,md,css,yml,yaml}\"",
    "clean": "turbo run clean && rm -rf node_modules",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "lint:fix": "eslint . --fix"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.1.2",
    "eslint": "^10.8.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.8.0",
    "prettier": "^3.9.6",
    "sharp": "^0.35.5",
    "turbo": "^2.10.8",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.65.0"
  }
}
